#!/usr/bin/env zsh
# ==============================================================================
# ANF — Unified Menu (Pintu untuk semua shell ANF)
# Satu perintah `anf` yang memilih shell, tanpa bongkar file FROZEN mana pun.
#
#   anf            -> menu interaktif (pilih Research / Cyber)
#   anf research   -> langsung MASUK ANF Research Shell (interaktif, ZLE popup)
#   anf cyber      -> langsung MASUK ANF Cyber Shell  (interaktif, ZLE popup)
#   anf research <cmd>  -> dispatch command tunggal (non-interaktif)
#   anf cyber    <cmd>  -> dispatch command tunggal (non-interaktif)
# ==============================================================================
set -u

_ANF_RESEARCH="${ANF_RESEARCH:-$HOME/.local/bin/anf-research}"
_ANF_CYBER="${ANF_CYBER:-$HOME/.local/bin/anf-cyber}"

_banner() {
  print ""
  print "  ANF — Unified Menu"
  print "  ──────────────────"
  print "   1) Research Shell   (anf-research : riset ML/math/reproducible)"
  print "   2) Cyber Shell      (anf-cyber    : purple-team/C2/recon/defense)"
  print "   0) Keluar"
  print ""
}

case "${1:-}" in
  research|r|1|cyber|c|2)
    # Pilih launcher berdasarkan nama
    local _launcher=""
    [[ "${1:-}" == research || "${1:-}" == r || "${1:-}" == 1 ]] && _launcher="$_ANF_RESEARCH"
    [[ "${1:-}" == cyber || "${1:-}" == c || "${1:-}" == 2 ]] && _launcher="$_ANF_CYBER"
    [[ -x "$_launcher" ]] || { print -u2 "launcher tidak ditemukan: $_launcher"; exit 1; }
    shift
    # Tanpa argumen -> launcher handle mode interaktif sendiri (exec zsh -i).
    # Dengan argumen -> dispatch command tunggal.
    exec "$_launcher" "$@"
    ;;
  ""|-h|--help)
    _banner
    print "  Gunakan:  anf research | anf cyber   (atau anf untuk menu interaktif)"
    ;;
  *)
    # Legacy: teruskan sebagai command ke research shell
    [[ -x "$_ANF_RESEARCH" ]] && exec "$_ANF_RESEARCH" "$@" \
      || { print -u2 "anf-research belum terpasang."; exit 1; }
    ;;
esac